# Change JWT_SECRET in every deployment. Never commit real credentials.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
DATABASE_URL=sqlite:///./talentatlas.db
# Offline demo mode: deterministic embeddings, SQLite vector index, extractive answers.
AI_MODE=demo
# Production mode: requires OpenAI, Qdrant, Redis.
# AI_MODE=live
# OPENAI_API_KEY=your_key
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# EMBEDDING_DIMENSION=1536
# QDRANT_URL=http://localhost:6333
# REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:8000
POSTGRES_PASSWORD=replace_with_a_strong_password
